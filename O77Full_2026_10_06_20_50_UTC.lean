  have hright :
      (∫⁻ s in strictOrderedPositive k,
        sortedLaguerreIntegrand eta rho T s ∂coordinateLebesgue (Fin k)) =
      ∫⁻ s in strictOrderedPositive k,
        ENNReal.ofReal (laguerreChamberIntegrand eta rho T s)
        ∂coordinateLebesgue (Fin k) :=
