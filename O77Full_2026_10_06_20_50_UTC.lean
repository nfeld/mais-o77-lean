    change (L : RM m m) * ((↑(L⁻¹) : RM m m) * M * (R : RM n n)) *
      (↑(R⁻¹) : RM n n) = M
    calc
      _ = ((L : RM m m) * (↑(L⁻¹) : RM m m)) * M *
