actual flattened nonlinear decoder, not with an assumed transport field. -/
theorem flat_local_image_bounds :
    ∃ (V : Set E0) (lo hi : ℝ), IsOpen V ∧ (0 : E0) ∈ V ∧
      V ⊆ flatTarget r alpha beta h p q ∧ 0 < lo ∧ 0 < hi ∧
