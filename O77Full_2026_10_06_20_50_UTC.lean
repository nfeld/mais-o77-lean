theorem lintegral_separated {k : ℕ} (S : Set (Fin k → ℝ))
    (W : AngularCoordinates k → ℝ≥0∞)
    (F : (Fin k → ℝ) → ℝ≥0∞) (hW : Measurable W) (hF : Measurable F) :
