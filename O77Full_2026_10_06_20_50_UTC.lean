      2 * (∫ r in Ioi (0 : ℝ), r ^ (n - 1) * f (r ^ 2)) =
        ∫ s in Ioi (0 : ℝ), s ^ ((n : ℝ) / 2 - 1) * f s := by
    rw [← integral_const_mul]
    exact (setIntegral_congr_fun measurableSet_Ioi
      (fun r hr => (hpoint r hr).symm)).trans (by simpa only [smul_eq_mul] using hsub)
