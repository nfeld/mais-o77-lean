@[simp] lemma sectionProd_map (f : V →ₗ[ℝ] W)
    (s : LinearMap.range f →ₗ[ℝ] V)
    (hs : f.rangeRestrict.comp s = LinearMap.id)
    (x : LinearMap.range f) (z : LinearMap.ker f) :
