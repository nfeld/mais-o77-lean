      (upperLebesgue k) := by
  exact (measurePreserving_piCongrLeft
      (fun _ : UpperIndex k => (volume : Measure ℝ)) (upperIndexSplit k)).comp
    (measurePreserving_sumPiEquivProdPi_symm
      (fun _ : Fin k ⊕ StrictUpperIndex k => (volume : Measure ℝ)))

