    IsEmpty (StrictUpperIndex k) := by
  constructor
  intro ij
  have hi := ij.1.1.isLt
  have hj := ij.1.2.isLt
  have hij := ij.2
  omega

theorem angularLebesgue_univ_of_le_one (k : ℕ) (hk : k ≤ 1) :
    angularLebesgue k Set.univ = 1 := by
  let := strictUpperIndex_isEmpty k hk
