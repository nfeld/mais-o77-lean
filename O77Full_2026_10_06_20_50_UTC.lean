    ((flatDecode_C1 r alpha beta h p q z hz).differentiableAt one_ne_zero).hasFDerivAt
    ((flatEncode_C1 r alpha beta h p q _ (flatDecode_mem r alpha beta h p q z hz)).differentiableAt one_ne_zero).hasFDerivAt
