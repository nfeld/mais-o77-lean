      (O77.FiberClassification.feasible_iff_realized Phi a b).mp Dab
    have hz := hPairs z hzf
    have hle := hmin z hzf _ _ hz
    rw [hlam, hza, hzb] at hle
    exact natCast_half_le_iff.mp hle
