  · ext u
    change T (s0 (pi u) + t (u-(pi u : U))) = u
    rw [map_add, h0v, htv]
    abel
  · ext c
    change s0 (pi (c : U)) + t ((c : U)-(pi (c : U) : U)) = s0 c
    have hp : pi (c : U) = c := Submodule.projectionOnto_apply_left hD c
